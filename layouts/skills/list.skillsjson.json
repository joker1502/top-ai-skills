{{ $skills := slice }}
{{ if .Parent.IsHome }}
  {{ $skills = .RegularPagesRecursive }}
{{ else }}
  {{ $category := .Params.category_filter | default "" }}
  {{ $skills = where .Parent.RegularPagesRecursive "Params.category" $category }}
{{ end }}
{
  "meta": {
    "title": {{ .Title | jsonify }},
    "description": {{ .Description | jsonify }},
    "total": {{ len $skills }}
  },
  "skills": [
    {{ range $i, $skill := $skills.ByTitle }}
    {
      "name": {{ $skill.Title | jsonify }},
      "slug": {{ $skill.File.ContentBaseName | jsonify }},
      "url": {{ $skill.Permalink | jsonify }},
      "description": {{ $skill.Description | jsonify }},
      "version": {{ $skill.Params.version | jsonify }},
      "author": {{ $skill.Params.author | jsonify }},
      "repo_url": {{ $skill.Params.repo_url | jsonify }},
      "install_cmd": {{ $skill.Params.install_cmd | jsonify }},
      "category": {{ $skill.Params.category | jsonify }},
      "rating": {{ $skill.Params.rating | default 0 }},
      "tags": {{ $skill.Params.tags | jsonify }},
      "compatibility": {{ $skill.Params.compatibility | jsonify }}
    }{{ if lt $i (sub (len $skills) 1) }},{{ end }}
    {{ end }}
  ]
}