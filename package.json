{
  "name": "top-ai-skills",
  "private": true,
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i assets/css/main.css -o assets/css/style.css",
    "build:css:watch": "npx @tailwindcss/cli -i assets/css/main.css -o assets/css/style.css --watch",
    "dev": "npm run build:css && hugo server",
    "build": "npm run build:css -- --minify && hugo --minify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "tailwindcss": "^4.0.0"
  }
}
